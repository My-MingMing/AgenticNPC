# === NPC Dialogue System - Environment Variables ===
# 复制此文件为 .env 并填入真实值

# ====== 数据合成阶段 (Stage 1-3) ======
# 推荐使用阿里云DashScope (Qwen3-235B) 或 DeepSeek API(便宜)
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=sk-your-dashscope-key-here

DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 默认LLM配置（如果不区分不同模型）
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-key-here

# ====== RL训练阶段 (Mock Tool/User/Reward) ======
MOCK_TOOL_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
MOCK_TOOL_API_KEY=sk-your-key-here
MOCK_TOOL_MODEL=qwen-plus

REWARD_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
REWARD_API_KEY=sk-your-key-here
REWARD_MODEL=qwen-plus

# ====== 推理服务阶段 ======
NPC_MODEL_API_BASE=http://localhost:8000/v1
NPC_MODEL_API_KEY=EMPTY
NPC_MODEL_NAME=default

REDIS_HOST=localhost
REDIS_PORT=6379

NPC_SERVER_HOST=0.0.0.0
NPC_SERVER_PORT=8080
